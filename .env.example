# CTI Warehouse environment template. Copy to .env and replace every change-me value.
# .env is git-ignored. Never put real secrets in this file. Reference: DEPLOYMENT_GUIDE.md §3.

# development | test | production (production refuses placeholder secrets)
CTI_ENV=development
CTI_LOG_LEVEL=INFO

# PostgreSQL credentials (used by the postgres container and to build URLs in docker-compose.yml)
POSTGRES_USER=cti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cti

# Application and test database URLs for NATIVE runs (docker compose builds its own URLs
# with host "postgres"). The test database is created by docker/postgres/init/ or manually.
CTI_DATABASE_URL=postgresql+psycopg://cti:change-me@localhost:5432/cti
CTI_TEST_DATABASE_URL=postgresql+psycopg://cti:change-me@localhost:5432/cti_test

# >= 32 random bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CTI_SECRET_KEY=change-me

# Session lifetime (absolute) and idle timeout, in minutes
CTI_SESSION_TTL_MINUTES=480
CTI_SESSION_IDLE_MINUTES=60

# Comma-separated origins allowed to call the API with credentials
CTI_CORS_ORIGINS=http://localhost:5173

# Writable directories. Relative paths resolve against the repository root.
CTI_UPLOAD_DIR=.local/uploads
CTI_ARTIFACT_DIR=.local/artifacts

# Ingestion (DATA_INGESTION.md): API upload limit, CLI import root (relative to the repository
# root), batch failure threshold for the rejected-record fraction, records per transaction.
CTI_MAX_UPLOAD_MB=50
CTI_IMPORT_ROOT=data
CTI_MAX_REJECT_RATIO=0.2
CTI_INGEST_CHUNK_SIZE=5000

# Query caps: maximum time span (days) for event queries and aggregations
CTI_MAX_QUERY_DAYS=400
CTI_MAX_AGG_DAYS=400

# Background worker
CTI_MAX_CONCURRENT_JOBS=2
CTI_JOB_HEARTBEAT_SECONDS=15
CTI_JOB_TIMEOUT_SECONDS=600
CTI_WORKER_POLL_SECONDS=2

# Frontend (Vite). Only VITE_* variables reach browser code; never put secrets in them.
VITE_API_BASE_URL=/api/v1
# Dev-server proxy target for /api (Node side only)
CTI_BACKEND_PROXY_TARGET=http://localhost:8000
